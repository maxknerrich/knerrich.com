{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "types": ["$app/types", "node"],
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  },
  // Type-checks frontmatter, embeds and writing links in src/content/**/*.md
  // (tsrs/TypeScript 7.1 with --runExternalCode; see tools/markdown-content-mapper).
  "contentMappers": [{ "package": "@knerrich/markdown-content-mapper", "extensions": [".md"] }],
  // Also the repo scripts and tools (run by plain `node`), and the Markdown content.
  "include": ["src", "vite.config.ts", "scripts/**/*.ts", "tools/**/*.ts", "src/content/**/*.md"]
}
