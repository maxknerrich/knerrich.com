{
  "name": "knerrich-com",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "prepare": "svelte-kit sync && vp config --no-agent",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "effect-tsgo tsrs --noEmit --runExternalCode && TSRS_LINT_RUN_EXTERNAL_CODE=1 effect-tsgo vp lint",
    "format": "vp fmt"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.2",
    "@knerrich/markdown-content-mapper": "link:tools/markdown-content-mapper",
    "@stylexjs/eslint-plugin": "0.19.2",
    "@stylexjs/unplugin": "^0.19.2",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/enhanced-img": "^1.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@takumi-rs/core": "2.21.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.2",
    "effect": "4.1.5",
    "hast-util-from-html": "^2.1.0",
    "hast-util-to-html": "^9.0.7",
    "marked": "^18.2.1",
    "shiki": "^4.6.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tsrs": "7.1.0-beta.tsrs2",
    "typescript": "^6.0.3",
    "vite-plus": "^1.7.0",
    "yaml": "^2.9.1"
  },
  "browserslist": [
    "baseline 2025"
  ],
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
    }
  }
}
